# Environment variables: configure in cPanel / hosting environment, never commit real values.
TD_DB_HOST=localhost
TD_DB_PORT=3306
TD_DB_NAME=tdcore
TD_DB_USER=tdcore_user
TD_DB_PASSWORD=REPLACE
TD_ADMIN_PASSWORD_HASH=REPLACE_WITH_PHP_PASSWORD_HASH
TD_LICENSE_PEPPER=REPLACE_WITH_32_BYTE_RANDOM_HEX_OR_LONGER
TD_SIGNING_PRIVATE_KEY_FILE=/home/ACCOUNT/private/tdcore_signing.pem
TD_FORCE_HTTPS=1
