Options -Indexes -MultiViews
AddType video/mp4 .mp4
AddType image/jpeg .jpg
DirectoryIndex index.php
<IfModule mod_rewrite.c>
 RewriteEngine On
 # Reject extension-based PHP URLs (internal front-controller rewrite is allowed).
 RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php(?:[\s?]) [NC]
 RewriteRule ^ - [R=404,L]
 # Never serve internal source, SQL, secrets, docs, or dotfiles.
 RewriteRule ^(?:app|private|vendor|tests)(?:/|$) - [F,L,NC]
 RewriteRule (^|/)\. - [F,L]
 RewriteRule \.(?:sql|log|md|pem|key|bak|ini|env|json|yml|yaml)$ - [F,L,NC]
 RewriteCond %{REQUEST_FILENAME} !-f
 RewriteCond %{REQUEST_FILENAME} !-d
 RewriteRule ^ index.php [QSA,L]
</IfModule>
<FilesMatch "^(?!index\.php$).+\.php$">
 Require all denied
</FilesMatch>
